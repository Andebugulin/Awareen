<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The app's accent. Everything the user reads as "interactive" is this
        orange: 29 hardcoded uses across the layouts, plus every Material
        widget that derives from colorPrimary.

        These were previously named purple_* and set to #121212 - the same
        value as the background - which made colorPrimary invisible, so every
        outlined MaterialButton drew its text and stroke in the background
        colour.
    -->
    <color name="accent_orange">#FFA500</color>
    <color name="on_accent">#121212</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="preview_header_active">#4CAF50</color>
    <color name="preview_header_not_active">#E0E0E0</color>
    <color name="app_background_dark">#121212</color>
    <color name="dialog_text_light">#FFFFFF</color>
    <color name="dialog_button_highlight">@color/accent_orange</color>

    <!--
        Surfaces: everything drawn "on top of" the app background. One shade
        for cards/dialogs, one lighter shade for controls that sit inside a
        card (flat buttons, spinners), one for the thin track/hairline layer.
    -->
    <color name="surface_dark">#1E1E1E</color>
    <color name="surface_variant_dark">#2A2A2A</color>
    <color name="control_track_dark">#333333</color>

    <!-- Text on dark surfaces, in descending emphasis. -->
    <color name="text_primary_dark">#E0E0E0</color>
    <color name="text_secondary_dark">#9E9E9E</color>
    <color name="text_muted_dark">#888888</color>
    <color name="text_hint_dark">#555555</color>

    <!-- Semantic status colors, independent of the user-configurable level colors. -->
    <color name="status_good">#4CAF50</color>
    <color name="status_warning">#FFC107</color>
    <color name="status_danger">#F44336</color>
    <color name="danger_button_background">#490904</color>

    <!-- Semi-transparent scrim used behind the floating overlay timer. -->
    <color name="scrim_overlay">#80000000</color>

</resources>