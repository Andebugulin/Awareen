<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        "Dusk in the mountains": a pine-night background, warm mist-white
        text, and one meadow-green accent. Every hue is taken from the
        landscape in the logo, so the app reads as one place rather than a
        set of Material defaults.

        Names describe roles, not hues (accent_primary, not accent_green),
        so a future palette change never leaves a name lying about its color.
    -->
    <color name="accent_primary">#AFCB93</color>
    <color name="on_accent">#15210F</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="preview_header_active">@color/accent_primary</color>
    <color name="preview_header_not_active">@color/text_secondary</color>
    <color name="app_background">#0F1613</color>
    <color name="dialog_text">@color/text_primary</color>
    <color name="dialog_button_highlight">@color/accent_primary</color>

    <!--
        Surfaces: everything drawn "on top of" the app background. One shade
        for cards/dialogs, one lighter shade for controls that sit inside a
        card (flat buttons, spinners), one for the thin track/hairline layer.
    -->
    <color name="surface">#151E1A</color>
    <color name="surface_variant">#1E2924</color>
    <color name="control_track">#2A3731</color>
    <color name="hairline">#222E28</color>

    <!-- Text on dark surfaces, in descending emphasis. Warm mist, not grey. -->
    <color name="text_primary">#ECE8DC</color>
    <color name="text_secondary">#A7B1A6</color>
    <color name="text_muted">#7F8A81</color>
    <color name="text_hint">#525D56</color>

    <!--
        Landscape layers used by the scenery drawables (header, preview,
        logo). Ordered far to near: distant ridges are lighter and bluer,
        like real atmospheric haze; the nearest ridge equals the background
        so the scene melts into the page.
    -->
    <color name="scene_sky_glow">#1D2D28</color>
    <color name="scene_ridge_far">#2C433B</color>
    <color name="scene_ridge_mid">#203229</color>
    <color name="scene_ridge_near">#16231D</color>
    <color name="scene_snow">#ECE8DC</color>
    <color name="scene_meadow">#9DBF86</color>

    <!--
        Semantic status colors, independent of both the app's accent and the
        user-configurable level colors. Earth tones (grass, wheat, ember,
        clay) so a warning still feels like it belongs to the same evening.
        status_high is a fourth tier Analytics uses between warning and danger.
    -->
    <color name="status_good">#9CC788</color>
    <color name="status_warning">#E5C77B</color>
    <color name="status_high">#E3A26C</color>
    <color name="status_danger">#DE7C6A</color>
    <color name="danger_button_background">#2A1E1A</color>

    <!--
        "Your day" donut on Analytics. A categorical set (identity, not
        status), validated as a ring in this order on the dark surface:
        sleep, work, free, screen.
    -->
    <color name="day_sleep">#3987E5</color>
    <color name="day_busy">#C98500</color>
    <color name="day_free">#199E70</color>
    <color name="day_screen">#E66767</color>

</resources>
