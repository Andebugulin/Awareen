<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">21sp</item>
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="SettingsGrid">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:columnCount">2</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_columnWeight">0</item> <item name="android:layout_rowWeight">1</item>
    </style>

    <style name="SettingsControl">
        <item name="android:layout_width">0dp</item> <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">fill_horizontal|center_vertical</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
    </style>

    <style name="SettingsControlLayout" parent="SettingsControl">
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SettingsSeekBar">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="SettingsSeekBarValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:minWidth">50dp</item> <item name="android:layout_gravity">center_vertical</item>
    </style>

    <!--
        Display Mode toggle (Always / Interval / Never). Explicit text,
        fill and stroke colours so the checked option reads as a filled
        accent chip with dark text, and the unchecked ones as accent
        outlines, on this app's dark surface.
    -->
    <style name="DisplayModeToggleButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/toggle_mode_text</item>
        <item name="backgroundTint">@color/toggle_mode_background</item>
        <item name="strokeColor">@color/control_track</item>
        <item name="rippleColor">@color/accent_primary</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="AlertDialog">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="colorAccent">@color/dialog_button_highlight</item>

        <item name="android:buttonBarPositiveButtonStyle">@style/AlertDialogButtonTextColor</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/AlertDialogButtonTextColor</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/AlertDialogButtonTextColor</item>
    </style>

    <style name="AlertDialogButtonTextColor" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/dialog_button_highlight</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CustomAlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_window_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/AlertDialogButtonTextColor</item>
        <item name="buttonBarNegativeButtonStyle">@style/AlertDialogButtonTextColor</item>
        <item name="buttonBarNeutralButtonStyle">@style/AlertDialogButtonTextColor</item>
    </style>

    <!--
        Filled accent call-to-action (Start Tracking, Save Settings). Used
        wherever a screen's single primary action needs to stand out.
    -->
    <style name="Widget.Awareen.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!--
        Stop Tracking. Deliberately quiet: a dark clay-tinted pill with a
        clay outline rather than an alarm-red slab. Stopping is a choice,
        not an emergency.
    -->
    <style name="Widget.Awareen.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/danger_button_background</item>
        <item name="android:textColor">@color/status_danger</item>
        <item name="strokeColor">@color/status_danger</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>

    <!--
        Flat, low-emphasis button that sits inside a card (Export / Import /
        Random Color). No elevation so it doesn't compete with the card it
        lives on.
    -->
    <style name="Widget.Awareen.Button.Flat" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="TextAppearance.Awareen.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Screen titles (Analytics, About) and card headings. -->
    <style name="TextAppearance.Awareen.Title" parent="">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="TextAppearance.Awareen.Heading" parent="">
        <item name="android:fontFamily">@font/fraunces</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Small letter-spaced caps label above a value (TODAY, LIFETIME). -->
    <style name="TextAppearance.Awareen.Overline" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- A flat card: surface + hairline, no drop shadow. -->
    <style name="Widget.Awareen.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hairline</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>