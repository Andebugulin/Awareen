<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Dark-only, deliberately: the emerald-and-champagne identity holds its
        look in both system modes. The parent is therefore the DARK Material
        theme, not .DayNight; with a DayNight parent, framework-drawn pieces
        (spinner popups, default dialogs) turn light in system light mode
        and clash with the app.

        windowLightStatusBar / windowLightNavigationBar are false so the
        system bar icons stay light against the dark bars. From API 35 the
        bars are drawn edge-to-edge and statusBarColor / navigationBarColor
        are ignored, so these flags are what keep the icons visible.
    -->
    <style name="Theme.Screentimetracker" parent="Theme.MaterialComponents.NoActionBar">
        <!--
            colorPrimary is what unstyled Material widgets draw themselves
            with - outlined button text and stroke, toggle-group selection,
            switches, ripples. It must never be the background colour.
        -->
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_primary</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorSecondaryVariant">@color/accent_primary</item>
        <item name="colorOnSecondary">@color/on_accent</item>

        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Sentence-case buttons everywhere: calmer than shouted caps. -->
        <item name="textAppearanceButton">@style/TextAppearance.Awareen.Button</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="colorControlActivated">@color/accent_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/app_background</item>
    </style>
</resources>
