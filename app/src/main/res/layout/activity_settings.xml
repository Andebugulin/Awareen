<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:fontFamily="@font/fraunces"
                android:textSize="28sp"
                android:textColor="@color/text_primary"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_cross"
                app:tint="@color/text_secondary"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>


        <!--
            The preview is a little window onto the landscape, with the timer
            floating over it the way it floats over other apps. The card only
            clips the corners; previewLayout is still the ConstraintLayout the
            activity repositions the timer within.
        -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Awareen.Card"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/previewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/previewScene"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:src="@drawable/scene_preview"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/previewTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:12:34"
                android:textSize="24sp"
                android:textColor="@color/status_good"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/previewLevel1Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 1"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/status_good"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/previewLevel2Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 2"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:id="@+id/previewLevel3Header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stage 3"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/text_primary"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Timer Display Settings"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpTimerDisplay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Timer Display do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display Mode"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/timerDisplayModeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/timerDisplayModeAlways"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Always" />

                <Button
                    android:id="@+id/timerDisplayModeInterval"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Interval" />

                <Button
                    android:id="@+id/timerDisplayModeNever"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Never" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <GridLayout
                style="@style/SettingsGrid"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="0dp">

                <TextView style="@style/SettingsLabel" android:text="Interval:" android:textColor="@color/text_primary" />
                <LinearLayout style="@style/SettingsControlLayout">
                    <SeekBar
                        android:id="@+id/timerDisplayIntervalSeekBar"
                        style="@style/SettingsSeekBar"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />
                    <TextView
                        android:id="@+id/timerDisplayIntervalValue"
                        style="@style/SettingsSeekBarValue"
                        android:text="1 min"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView style="@style/SettingsLabel" android:text="Duration:" android:textColor="@color/text_primary" />
                <LinearLayout style="@style/SettingsControlLayout">
                    <SeekBar
                        android:id="@+id/timerDisplayDurationSeekBar"
                        style="@style/SettingsSeekBar"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />
                    <TextView
                        android:id="@+id/timerDisplayDurationValue"
                        style="@style/SettingsSeekBarValue"
                        android:text="5 sec"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_background"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corner Style"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/overlayCornerStyleToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <Button
                    android:id="@+id/overlayCornerStyleSquare"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Square" />

                <Button
                    android:id="@+id/overlayCornerStyleRounded"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rounded" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Colored Border"
                    android:textColor="@color/text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlayBorderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    app:thumbTint="@color/accent_primary"
                    app:trackTint="@color/control_track" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/stage1SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Stage 1 Settings (0 - X min)"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpLevel1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What is Stage 1?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <GridLayout
            style="@style/SettingsGrid"
            android:background="@drawable/rounded_background">
            <TextView style="@style/SettingsLabel" android:text="Color:" android:textColor="@color/text_primary" />
            <Button android:id="@+id/level1ColorButton" style="@style/SettingsControl" android:text="Pick Color" />

            <TextView style="@style/SettingsLabel" android:text="Position:" android:textColor="@color/text_primary" />
            <Spinner
                android:id="@+id/level1PositionSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Font Size:" android:textColor="@color/text_primary" />
            <LinearLayout style="@style/SettingsControlLayout">
                <SeekBar
                    android:id="@+id/level1FontSizeSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />
                <TextView
                    android:id="@+id/level1FontSizeValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="24sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:text="Enable Blinking:"
                android:textColor="@color/text_primary" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/level1BlinkingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:minHeight="48dp"
                app:thumbTint="@color/accent_primary"
                app:trackTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Max Time:" android:textColor="@color/text_primary" />
            <LinearLayout style="@style/SettingsControlLayout">
                <SeekBar
                    android:id="@+id/level1TimeSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />
                <TextView
                    android:id="@+id/level1TimeValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="30 min"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </GridLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/stage2SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Stage 2 Settings (Stage 1 Max - Y min)"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpLevel2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What is Stage 2?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>
        <GridLayout
            style="@style/SettingsGrid"
            android:background="@drawable/rounded_background">
            <TextView style="@style/SettingsLabel" android:text="Color:" android:textColor="@color/text_primary" />
            <Button android:id="@+id/level2ColorButton" style="@style/SettingsControl" android:text="Pick Color" />
            <TextView style="@style/SettingsLabel" android:text="Position:" android:textColor="@color/text_primary" />
            <Spinner
                android:id="@+id/level2PositionSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Font Size:" android:textColor="@color/text_primary" />
            <LinearLayout style="@style/SettingsControlLayout">
                <SeekBar
                    android:id="@+id/level2FontSizeSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />
                <TextView
                    android:id="@+id/level2FontSizeValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="26sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:text="Enable Blinking:"
                android:textColor="@color/text_primary" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/level2BlinkingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:minHeight="48dp"
                app:thumbTint="@color/accent_primary"
                app:trackTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Duration:" android:textColor="@color/text_primary" />
            <LinearLayout style="@style/SettingsControlLayout">
                <SeekBar
                    android:id="@+id/level2TimeSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />
                <TextView
                    android:id="@+id/level2TimeValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="30 min"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </GridLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/stage3SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Stage 3 Settings (Above Stage 2 Max)"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpLevel3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What is Stage 3?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>
        <GridLayout
            style="@style/SettingsGrid"
            android:background="@drawable/rounded_background">
            <TextView style="@style/SettingsLabel" android:text="Color:" android:textColor="@color/text_primary" />
            <Button android:id="@+id/level3ColorButton" style="@style/SettingsControl" android:text="Pick Color" />
            <TextView style="@style/SettingsLabel" android:text="Position:" android:textColor="@color/text_primary" />
            <Spinner
                android:id="@+id/level3PositionSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Font Size:" android:textColor="@color/text_primary" />
            <LinearLayout style="@style/SettingsControlLayout">
                <SeekBar
                    android:id="@+id/level3FontSizeSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />
                <TextView
                    android:id="@+id/level3FontSizeValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="28sp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                style="@style/SettingsLabel"
                android:text="Enable Blinking:"
                android:textColor="@color/text_primary" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/level3BlinkingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:minHeight="48dp"
                app:thumbTint="@color/accent_primary"
                app:trackTint="@color/control_track"
                tools:checked="true" />
        </GridLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Daily Reset Time"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpResetTime"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Daily Reset do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>
        <GridLayout
            style="@style/SettingsGrid"
            android:background="@drawable/rounded_background">
            <TextView style="@style/SettingsLabel" android:text="Hour (24h):" android:textColor="@color/text_primary" />
            <Spinner
                android:id="@+id/resetHourSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />

            <TextView style="@style/SettingsLabel" android:text="Minute:" android:textColor="@color/text_primary" />
            <Spinner
                android:id="@+id/resetMinuteSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />
        </GridLayout>

        <!-- Import / Export Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Import &amp; Export"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpImportExport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Import &amp; Export do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save or restore your settings as a JSON file."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/exportSettingsButton"
                    style="@style/Widget.Awareen.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Export"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/importSettingsButton"
                    style="@style/Widget.Awareen.Button.Flat"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Import"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            style="@style/Widget.Awareen.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Save settings"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>