<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings. There is no in-page preview: while this screen is open the real
    floating timer is shown for the selected stage, and every change below is
    saved and applied to it immediately. One stage editor is bound to the
    stage picked in the tabs, instead of three identical blocks.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    tools:context=".ui.SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:fontFamily="@font/fraunces"
                android:text="Settings"
                android:textColor="@color/text_primary"
                android:textSize="28sp" />

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:padding="6dp"
                android:src="@drawable/ic_cross"
                app:tint="@color/text_secondary" />
        </RelativeLayout>

        <TextView
            android:id="@+id/liveHintTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="The timer on your screen is live. Drag it anywhere, and every change here shows up on it right away."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ============================ STAGES ============================ -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Stages"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpStages"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What are stages?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/stageToggleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/stageTab1"
                style="@style/DisplayModeToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Calm" />

            <Button
                android:id="@+id/stageTab2"
                style="@style/DisplayModeToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Heads up" />

            <Button
                android:id="@+id/stageTab3"
                style="@style/DisplayModeToggleButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Enough" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/stageRangeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="From 0 to 30 min of screen time"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <GridLayout style="@style/SettingsGrid">

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Name:"
                    android:textColor="@color/text_primary" />

                <EditText
                    android:id="@+id/stageNameInput"
                    style="@style/SettingsControl"
                    android:background="@drawable/rounded_background"
                    android:hint="Stage name"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="16"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Text color:"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/stageTextColorButton"
                    style="@style/SettingsControl"
                    android:fontFamily="monospace" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Background:"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/stageBackgroundColorButton"
                    style="@style/SettingsControl"
                    android:fontFamily="monospace" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Position:"
                    android:textColor="@color/text_primary" />

                <Spinner
                    android:id="@+id/stagePositionSpinner"
                    style="@style/SettingsControl"
                    android:backgroundTint="@color/control_track" />

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Font size:"
                    android:textColor="@color/text_primary" />

                <LinearLayout style="@style/SettingsControlLayout">

                    <SeekBar
                        android:id="@+id/stageFontSizeSeekBar"
                        style="@style/SettingsSeekBar"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />

                    <TextView
                        android:id="@+id/stageFontSizeValue"
                        style="@style/SettingsSeekBarValue"
                        android:text="24sp"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:text="Blinking:"
                    android:textColor="@color/text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/stageBlinkingSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"
                    android:minHeight="48dp"
                    app:thumbTint="@color/accent_primary"
                    app:trackTint="@color/control_track" />
            </GridLayout>

            <!-- Stage 1 "ends after" / stage 2 "lasts"; hidden for stage 3. -->
            <LinearLayout
                android:id="@+id/stageThresholdRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/stageThresholdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Ends after:"
                    android:textColor="@color/text_primary" />

                <SeekBar
                    android:id="@+id/stageThresholdSeekBar"
                    style="@style/SettingsSeekBar"
                    android:progressTint="@color/accent_primary"
                    android:thumbTint="@color/accent_primary" />

                <TextView
                    android:id="@+id/stageThresholdValue"
                    style="@style/SettingsSeekBarValue"
                    android:text="30 min"
                    android:textColor="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================= TIMER DISPLAY ========================= -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="When it shows"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpTimerDisplay"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Timer Display do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/timerDisplayModeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/timerDisplayModeAlways"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Always" />

                <Button
                    android:id="@+id/timerDisplayModeInterval"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Interval" />

                <Button
                    android:id="@+id/timerDisplayModeNever"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Never" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <GridLayout
                android:id="@+id/timerIntervalGrid"
                style="@style/SettingsGrid"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="0dp">

                <TextView
                    style="@style/SettingsLabel"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:text="Every:"
                    android:textColor="@color/text_primary" />

                <LinearLayout style="@style/SettingsControlLayout">

                    <SeekBar
                        android:id="@+id/timerDisplayIntervalSeekBar"
                        style="@style/SettingsSeekBar"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />

                    <TextView
                        android:id="@+id/timerDisplayIntervalValue"
                        style="@style/SettingsSeekBarValue"
                        android:text="1 min"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    style="@style/SettingsLabel"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:text="For:"
                    android:textColor="@color/text_primary" />

                <LinearLayout style="@style/SettingsControlLayout">

                    <SeekBar
                        android:id="@+id/timerDisplayDurationSeekBar"
                        style="@style/SettingsSeekBar"
                        android:progressTint="@color/accent_primary"
                        android:thumbTint="@color/accent_primary" />

                    <TextView
                        android:id="@+id/timerDisplayDurationValue"
                        style="@style/SettingsSeekBarValue"
                        android:text="5 sec"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <!-- ============================= SHAPE ============================= -->

        <TextView
            style="@style/SettingsHeader"
            android:layout_marginTop="8dp"
            android:text="Shape"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/overlayCornerStyleToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/overlayCornerStyleSquare"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Square" />

                <Button
                    android:id="@+id/overlayCornerStyleRounded"
                    style="@style/DisplayModeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rounded" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Border in the stage color"
                    android:textColor="@color/text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/overlayBorderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    app:thumbTint="@color/accent_primary"
                    app:trackTint="@color/control_track" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================== DAILY RESET ========================== -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Daily reset"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpResetTime"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Daily Reset do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <GridLayout
            style="@style/SettingsGrid"
            android:background="@drawable/rounded_background">

            <TextView
                style="@style/SettingsLabel"
                android:text="Hour (24h):"
                android:textColor="@color/text_primary" />

            <Spinner
                android:id="@+id/resetHourSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />

            <TextView
                style="@style/SettingsLabel"
                android:text="Minute:"
                android:textColor="@color/text_primary" />

            <Spinner
                android:id="@+id/resetMinuteSpinner"
                style="@style/SettingsControl"
                android:backgroundTint="@color/control_track" />
        </GridLayout>

        <!-- ======================== IMPORT / EXPORT ======================== -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsHeader"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:text="Import &amp; export"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/helpImportExport"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="What does Import &amp; Export do?"
                android:padding="6dp"
                android:src="@drawable/ic_info"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/rounded_background"
            android:orientation="horizontal"
            android:padding="12dp">

            <Button
                android:id="@+id/exportSettingsButton"
                style="@style/Widget.Awareen.Button.Flat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="Export"
                android:textSize="14sp" />

            <Button
                android:id="@+id/importSettingsButton"
                style="@style/Widget.Awareen.Button.Flat"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Import"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/doneButton"
            style="@style/Widget.Awareen.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Done"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
